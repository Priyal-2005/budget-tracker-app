# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to ship in a mobile app — it only allows what your
# Row Level Security policies permit, it is not a secret admin key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key